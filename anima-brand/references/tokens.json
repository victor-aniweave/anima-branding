    "note": "同一套五色系統，不引入新顏色；Ripple 三種情境固定 5%。",
    "bdDeckQuote":       { "depth": 35, "mist": 45, "ripple": 5, "current": 10, "sky": 5 },
    "productInterface":  { "depth": 30, "mist": 40, "ripple": 5, "current": 15, "sky": 10 },
    "socialMarketing":   { "depth": 20, "mist": 30, "ripple": 5, "current": 10, "sky": 35 }
