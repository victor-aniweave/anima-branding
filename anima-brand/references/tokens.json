{
  "meta": {
    "name": "ANIMA Design Tokens",
    "version": "1.1",
    "note": "五組色階（50–900），不新增色階；深色模式只換用同一組色階裡不同的階數。"
  },
  "colors": {
    "sky": {
      "alias": "Primary — Anima Sky",
      "usage": "標誌主色，500 為 #42BFFF",
      "50": "#ECF9FF", "100": "#C4EBFF", "200": "#A8E2FF", "300": "#80D4FF", "400": "#68CCFF",
      "500": "#42BFFF", "600": "#3CAEE8", "700": "#2F88B5", "800": "#24698C", "900": "#1C506B"
    },
    "current": {
      "alias": "Secondary — Current",
      "usage": "互動元件、連結、強調狀態，500 為 #1F59E0",
      "50": "#E9EEFC", "100": "#BACCF5", "200": "#98B3F1", "300": "#6990EA", "400": "#4C7AE6",
      "500": "#1F59E0", "600": "#1C51CC", "700": "#163F9F", "800": "#11317B", "900": "#0D255E"
    },
    "ripple": {
      "alias": "Accent — Ripple",
      "usage": "輕量點綴用的輔色，500 為 #59E3E6",
      "50": "#EEFCFD", "100": "#CCF6F7", "200": "#B3F2F4", "300": "#90ECEE", "400": "#7AE9EB",
      "500": "#59E3E6", "600": "#51CFD1", "700": "#3FA1A3", "800": "#317D7F", "900": "#255F61"
    },
    "depth": {
      "alias": "Tertiary — Depth",
      "usage": "標準字、內文、圖示線條，700 為 #33454E",
      "50": "#F6F8F9", "100": "#E3EAED", "200": "#CDD8DE", "300": "#ABBDC5", "400": "#8BA4B0",
      "500": "#5C7E8E", "600": "#4B6672", "700": "#33454E", "800": "#222D33", "900": "#151D20"
    },
    "mist": {
      "alias": "Grey — Mist",
      "usage": "純中性灰，900 固定作為深色背景底色",
      "50": "#FCFCFC", "100": "#F5F5F5", "200": "#F0F0F0", "300": "#D9D9D9", "400": "#BFBFBF",
      "500": "#8C8C8C", "600": "#595959", "700": "#454545", "800": "#262626", "900": "#1F1F1F"
    }
  },
  "semantic": {
    "light": {
      "bgPage": "#FFFFFF",
      "bgCard": "mist.50",
      "border": "mist.200",
      "textPrimary": "depth.700",
      "textSecondary": "mist.600",
      "textAccent": "sky.700",
      "brand": "sky.500",
      "interactive": "current.500",
      "accentDecorative": "ripple.500",
      "buttonSolidBg": "current.500",
      "buttonSolidText": "#FFFFFF"
    },
    "dark": {
      "bgPage": "mist.900",
      "bgCard": "mist.800",
      "border": "mist.700",
      "textPrimary": "#FFFFFF",
      "textSecondary": "mist.300",
      "textAccent": "sky.300",
      "brand": "sky.500",
      "interactive": "current.400",
      "accentDecorative": "ripple.500",
      "buttonSolidBg": "current.400",
      "buttonSolidText": "#FFFFFF",
      "buttonSolidTextRule": "字重 ≥ 600、字級 ≥ 14px（對比僅 4.01:1，大字合格）"
    }
  },
  "contrastPairs": [
    { "bg": "#FFFFFF", "fg": "depth.700", "ratio": "9.99:1", "usage": "一般內文" },
    { "bg": "#FFFFFF", "fg": "current.500", "ratio": "5.89:1", "usage": "連結文字" },
    { "bg": "#FFFFFF", "fg": "mist.600", "ratio": "7.00:1", "usage": "次要文字" },
    { "bg": "sky.500", "fg": "#FFFFFF", "ratio": "2.07:1", "usage": "不合格，Sky 500 底不可配白字" },
    { "bg": "sky.500", "fg": "depth.700", "ratio": "4.82:1", "usage": "Sky 500 底唯一合格組合" },
    { "bg": "current.500", "fg": "#FFFFFF", "ratio": "5.89:1", "usage": "實心按鈕，淺色模式" },
    { "bg": "current.400", "fg": "#FFFFFF", "ratio": "4.01:1", "usage": "實心按鈕，深色模式；按鈕文字須維持字重 ≥ 600、字級 ≥ 14px" },
    { "bg": "mist.900", "fg": "#FFFFFF", "ratio": "16.48:1", "usage": "深底主標題／標誌" },
    { "bg": "mist.900", "fg": "sky.200", "ratio": "11.76:1", "usage": "深底次要文字、說明、標籤" },
    { "bg": "#FFFFFF", "fg": "sky.700", "ratio": "3.95:1", "usage": "數字／強調文字" },
    { "bg": "mist.900", "fg": "sky.300", "ratio": "10.03:1", "usage": "深底數字／強調" }
